# Même projet Supabase que l'app principale.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ID du restaurant dont le menu doit être affiché (table restaurants).
NEXT_PUBLIC_RESTAURANT_ID=

# URL publique de cette app (utilisée pour les URLs de retour de paiement).
NEXT_PUBLIC_SITE_URL=https://commander.sarifood.example

# PayDunya (https://developers.paydunya.com) — gère Wave/Orange Money/Free
# Money/carte sur sa page hébergée. PAYDUNYA_MODE=test utilise l'URL sandbox
# avec les clés de test ; passer à live (clés live + PAYDUNYA_MODE=live)
# ensemble, jamais l'un sans l'autre (l'API refuse un mélange test/live).
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
